pkgname=nook
pkgver=0.1.0
pkgrel=11
pkgdesc='A calm little drawer for your retro games'
arch=('aarch64' 'x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg' 'qt6-wayland' 'sdl3' 'retroarch')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/nook "$pkgdir/usr/bin/nook"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/nook.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/nook.svg"
  install -Dm644 "$startdir/nook.desktop" "$pkgdir/usr/share/applications/nook.desktop"
}
